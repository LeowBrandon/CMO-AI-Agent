# Documentation only: server.py reads the process environment, not .env files.
# Enter a real API key securely through your environment settings, never here.
CMO_LLM_PROVIDER=deepseek
CMO_LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
CMO_DAILY_GENERATION_LIMIT=30
# CMO_DB_PATH=/path/to/private/cmo.sqlite3

# Optional generic override (takes precedence; also used for OpenAI):
# CMO_LLM_API_KEY=
